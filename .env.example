# Browser (Vercel + .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server only — mint a session after MSG91 verifies the SMS
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# MSG91 OTP Widget (Client Side Integration: widgetId + tokenAuth)
MSG91_WIDGET_ID=your_widget_id
MSG91_TOKEN_AUTH=your_widget_token
MSG91_AUTHKEY=your_msg91_authkey

# Razorpay one-time theme checkout (Test keys first)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
