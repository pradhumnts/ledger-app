# Browser (Vercel + .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server only — mint a session after MSG91 verifies the SMS
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# MSG91 OTP Widget (Client Side Integration: widgetId + tokenAuth)
MSG91_WIDGET_ID=your_widget_id
MSG91_TOKEN_AUTH=your_widget_token
MSG91_AUTHKEY=your_msg91_authkey

# Razorpay one-time theme checkout (website / browsers without Play Billing)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Google Play Billing (TWA). Package name must match PWABuilder exactly.
NEXT_PUBLIC_PLAY_PACKAGE_NAME=app.moneykit.android
PLAY_PACKAGE_NAME=app.moneykit.android
# Full service account JSON on one line (Play Console API access)
PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Comma-separated SHA-256 fingerprints from Play App signing + upload key
PLAY_SHA256_CERT_FINGERPRINTS=AB:CD:EF:...

# App Store purchases (iPhone app). App Store Connect → Users and Access →
# Integrations → In-App Purchase: issuer ID, key ID and the .p8 key (newlines as \n).
APPLE_BUNDLE_ID=app.moneykit.ios
# Numeric Apple ID from App Store Connect → App Information
APPLE_APP_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# App Store listing; /get install links send iPhones here once set.
APP_STORE_URL=

# Store reviewer login (static OTP, no SMS), used by Google Play and App Review.
PLAY_REVIEW_PHONE=9999999999
PLAY_REVIEW_OTP=123456

# Referrals. Offer ID of the 10%-off-first-year offer on the yearly base plan.
REFERRAL_OFFER_ID=referral-10
# Yearly website base plan IDs (comma-separated). Blank: any ID containing "year" or "annual".
SITES_YEARLY_BASE_PLAN_IDS=
# Signs affiliate (/partner) logins. Blank: derived from SUPABASE_SERVICE_ROLE_KEY.
PARTNER_SESSION_SECRET=

# IARC certificate ID from Play Console → App content → Content ratings
NEXT_PUBLIC_IARC_RATING_ID=

# Shop phones that get every paid bill + QR theme unlocked (comma-separated)
NEXT_PUBLIC_ADMIN_THEME_PHONES=8740074255

# Closed testing: unlock every bill + QR theme (Choose, not Buy). Play Billing stays in the app.
# Set to false / remove before Production if themes should be paid again.
NEXT_PUBLIC_THEMES_FREE=true

# PostHog product analytics (optional). Leave blank to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Ads conversion tag (marketing landing + legal pages).
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18420195654

# Web Push reminders (currently off in src/lib/reminders-enabled.js).
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Protects /api/cron/* — Vercel sends this as Authorization: Bearer …
CRON_SECRET=

# Website interest emails (Notify me / I want a website). Reuse the Mably Resend account for now.
RESEND_API_KEY=
RESEND_FROM=Mably <noreply@mably.io>
WEBSITE_LEAD_TO=hello@prad.dev
