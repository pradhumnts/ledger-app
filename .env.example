# Browser (Vercel + .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server only — mint a session after MSG91 verifies the SMS
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# MSG91 OTP Widget (Client Side Integration: widgetId + tokenAuth)
MSG91_WIDGET_ID=your_widget_id
MSG91_TOKEN_AUTH=your_widget_token
MSG91_AUTHKEY=your_msg91_authkey

# Razorpay one-time theme checkout (website / browsers without Play Billing)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Google Play Billing (TWA). Package name must match PWABuilder exactly.
NEXT_PUBLIC_PLAY_PACKAGE_NAME=app.moneykit.android
PLAY_PACKAGE_NAME=app.moneykit.android
# Full service account JSON on one line (Play Console API access)
PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Comma-separated SHA-256 fingerprints from Play App signing + upload key
PLAY_SHA256_CERT_FINGERPRINTS=AB:CD:EF:...

# Google Play reviewer login (static OTP, no SMS). Keep in sync with Play Console.
PLAY_REVIEW_PHONE=9999999999
PLAY_REVIEW_OTP=123456

# IARC certificate ID from Play Console → App content → Content ratings
NEXT_PUBLIC_IARC_RATING_ID=

# Shop phones that get every paid bill + QR theme unlocked (comma-separated)
NEXT_PUBLIC_ADMIN_THEME_PHONES=8740074255

# Closed testing: unlock every bill + QR theme (Choose, not Buy). Play Billing stays in the app.
# Set to false / remove before Production if themes should be paid again.
NEXT_PUBLIC_THEMES_FREE=true

# PostHog product analytics (optional). Leave blank to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Web Push reminders for signed-in shops (unshared bills 8pm IST, old dues 3pm IST).
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Protects /api/cron/* — Vercel sends this as Authorization: Bearer …
CRON_SECRET=
